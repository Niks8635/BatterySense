# BatterySense - Frontend Environment Configuration
# URL of the local Windows monitoring agent (default: http://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000

# WebSocket URL for real-time telemetry streaming (default: ws://127.0.0.1:8000/ws/telemetry)
VITE_WS_URL=ws://127.0.0.1:8000/ws/telemetry
